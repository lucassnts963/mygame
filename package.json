{
  "name": "vestigio",
  "version": "0.1.0",
  "description": "Vestígio — jogo de mistério com mapa, realidade aumentada geolocalizada e personagens-agentes de IA.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "playtest": "node --experimental-strip-types packages/module-schema/src/cli/playtest.ts",
    "validate-module": "node --experimental-strip-types packages/module-schema/src/cli/validate.ts",
    "check": "node scripts/check-consistency.mjs",
    "changelog": "node scripts/update-changelog.mjs",
    "changelog:check": "node scripts/update-changelog.mjs --check",
    "skills:index": "node scripts/update-skills-index.mjs",
    "skills:index:check": "node scripts/update-skills-index.mjs --check",
    "session": "node scripts/session-context.mjs",
    "release": "node scripts/cut-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
